# Java4Shell (CVE-2026-114938) — EXPERIMENTAL network rules
#
# These rules match SHAPES associated with malformed Base64 inputs, not a working exploit.
# They are not validated against production traffic. Expect false positives from legitimate
# Base64 that happens to contain long runs of 'A'. Start in alert-only mode on a SPAN port,
# review hits, then decide locally about blocking. Do not present them as coverage.
#
# The vulnerability is in local Base64 decoding, so network detection is weak by nature.
# The stronger controls are the exposure check, patch level and host-side JVM crash telemetry.

alert http $EXTERNAL_NET any -> $HOME_NET any ( \
  msg:"EXPERIMENTAL Java4Shell CVE-2026-114938 malformed Basic auth Base64 trigger shape"; \
  flow:established,to_server; \
  content:"Authorization|3a 20|Basic "; http_header; nocase; \
  pcre:"/Authorization\x3a Basic [A]{32,}={1,2}\r\n/Hi"; \
  threshold: type limit, track by_src, count 3, seconds 60; \
  sid:2202611001; rev:1; \
  metadata: cve CVE-2026-114938, confidence experimental, created_at 2026_11_18; \
  classtype:web-application-attack;)

alert http $EXTERNAL_NET any -> $HOME_NET any ( \
  msg:"EXPERIMENTAL Java4Shell CVE-2026-114938 long A-run Base64 tail in HTTP request"; \
  flow:established,to_server; \
  content:"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"; \
  pcre:"/[A]{48,}={1,2}(?:[^A-Za-z0-9+\/=]|$)/"; \
  threshold: type limit, track by_src, count 5, seconds 60; \
  sid:2202611002; rev:1; \
  metadata: cve CVE-2026-114938, confidence experimental, created_at 2026_11_18; \
  classtype:web-application-attack;)
